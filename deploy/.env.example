# Run python deploy/generate_env.py to create fresh URL-safe secrets.
POSTGRES_PASSWORD=replace_with_generated_password
MINIO_ROOT_USER=bidlsp
MINIO_ROOT_PASSWORD=replace_with_generated_password
JWT_SECRET=replace_with_at_least_32_random_bytes
# local = 本地共享卷（默认，无需 MinIO）；minio = 使用 --profile minio 启动的 MinIO
STORAGE_BACKEND=local
MINIO_PUBLIC_ENDPOINT=localhost:9000
PUBLIC_API_URL=http://localhost:8080
CORS_ORIGINS=["http://localhost:5173"]
